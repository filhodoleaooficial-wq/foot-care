# ==================== FRONTEND (build args) ====================
# Usados no Docker build. São injetados automaticamente via docker-compose.
# VITE_SUPABASE_URL=https://${API_DOMAIN}
# VITE_SUPABASE_PUBLISHABLE_KEY=${ANON_KEY}
# VITE_SUPABASE_PROJECT_ID=self-hosted

# ==================== POSTGRES ====================
POSTGRES_PASSWORD=postgres_senha_segura_123
POSTGRES_USER=postgres
POSTGRES_DB=supabase

# ==================== SUPABASE KEYS ====================
