# ==================== DASHBOARD ====================
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin_senha_segura_123

# ==================== EMAIL (SMTP) ====================
# Opcional - para enviar emails de recuperação de senha
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=sua_sendgrid_api_key_123
SMTP_SENDER_NAME=PeSaude
SMTP_SENDER_EMAIL=noreply@seudominio.com
SMTP_ADMIN_EMAIL=admin@seudominio.com

# ==================== STORAGE ====================
STORAGE_BACKEND=file  # 'file' para local, 's3' para S3-compatible
FILE_SIZE_LIMIT=52428800

# S3 (opcional, use se STORAGE_BACKEND=s3)
# GLOBAL_S3_BUCKET=meu-bucket
# GLOBAL_S3_ENDPOINT=https://s3.seudominio.com
# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx
# AWS_DEFAULT_REGION=us-east-1

# ==================== EDGE FUNCTIONS ====================
# Chave interna para verificação das edge functions
INTERNAL_VERIFICATION_KEY=verification_key_para_edge_functions
INTERNAL_VERIFICATION_TOKEN=verification_token_para_edge_functions
